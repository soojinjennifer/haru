{
  "name": "@haru/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HARU design tokens — 3-tier (primitive → semantic → component) CSS variables + Tailwind v4 theme/utilities (Stage 1 Plan §9.2, Design Spec §3)",
  "license": "UNLICENSED",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./dist/index.css",
    "./index.css": "./dist/index.css",
    "./component.css": "./dist/component.css",
    "./manifest.json": "./dist/tokens-manifest.json",
    "./assets/*": "./dist/assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "sync:fonts": "node scripts/sync-fonts.mjs",
    "build": "node scripts/sync-fonts.mjs && node scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "~5.3.0"
  },
  "devDependencies": {
    "@haru/config": "workspace:*",
    "@types/node": "^24.13.5",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11"
  }
}
