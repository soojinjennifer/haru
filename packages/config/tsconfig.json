{
  "extends": "./tsconfig/node.json",
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true
  },
  "include": [
    "types/**/*.d.ts",
    "eslint/**/*.js",
    "prettier/**/*.js",
