# HARU — Stage 1 Plan §16.1 D-10
#
# 주의 (2026-09-18 확인): pnpm 12 는 auth / registry 설정만 .npmrc 에서 읽는다.
# 나머지 pnpm 설정(engineStrict, preferWorkspacePackages, linkWorkspacePackages)의
# 실제 적용 지점은 pnpm-workspace.yaml 이다.
# 아래 engine-strict 는 승인된 정책의 기록이자 npm / yarn 으로 접근하는 경우의 안전장치다.
# (.nvmrc = 24.21.0, package.json engines.node = ">=24.21.0 <25")
engine-strict=true
