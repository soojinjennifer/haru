# HARU Frontend 환경 변수 예시 (Stage 1 Plan §9.0)
# Secret(Service Role Key, AI Key, STT Secret)을 이 파일이나 VITE_* 변수에 넣지 않는다.
# (.claude/rules/architecture.md §9)

# Http Adapter 가 사용할 API base URL. VITE_API_MODE=http 일 때만 의미가 있다.
VITE_API_BASE_URL=https://api.example.invalid

# API Adapter 선택 지점 (app/providers 한 곳에서만 읽는다): mock | http
VITE_API_MODE=mock

# Mock scenario 빌드 기본값 (우선순위: URL query > dev panel > 이 값 > success)
VITE_MOCK_SCENARIO=success
